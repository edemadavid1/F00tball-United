# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Android App Bundle / Direct APK Download Link
VITE_ANDROID_DOWNLOAD_URL="https://github.com/edemadavid1/gameon-android/releases/download/v1.0.0/gameon-app.apk"

# GOOGLE SERVICE ACCOUNT FOR AUTOMATED SHEETS EXPORT
# Paste the entire JSON content of your Google Cloud Service Account key or set credentials file path
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# EMAIL / SMTP CONFIGURATION FOR CARER CONSENT & ADMIN APPROVAL NOTIFICATIONS
# (Optional - if omitted, alert emails are logged automatically for auditing)
ADMIN_NOTIFICATION_EMAIL="admin@football-united.com"
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL="noreply@football-united.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Football United Safeguarding <noreply@footballunited.org.uk>"
APP_BASE_URL="https://www.football-united.com"

# MICROSOFT GRAPH EMAIL & EXCEL ONLINE CONFIGURATION (AUTOMATED CONSENT MAILER & REPORTS)
# Tenant ID, Client ID and Client Secret from Azure App Registration with Mail.Send and Files.ReadWrite.All permissions
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER="refugeeresponse@hillsong.co.uk"
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=

# MICROSOFT 365 ATTENDANCE TEMPLATE DUPLICATION & USER DRIVE SYNC
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
TARGET_USER_EMAIL="ralph.boer@hillsong.co.uk"
MS_WORKBOOK_ID="89444D16-E69C-4E91-A119-C0B054023930"
MS_WORKSHEET_NAME="WeeklyAttendance"
MS_TEMPLATE_FILE_ID=
SHAREPOINT_FOLDER_NAME="WeeklyReports"

# MICROSOFT FORMS / POWER AUTOMATE WEBHOOK SECRET
MSFORMS_WEBHOOK_SECRET=


