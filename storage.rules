rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Youth player profile photos & ID photos bucket
    match /player_id_photos/{imageId} {
      // Allow public, unauthenticated uploads for new player registrations
      // Enforce strict constraints: images only, max 5MB size limit
      allow create: if request.resource.size < 5 * 1024 * 1024 
                    && request.resource.contentType.matches('image/.*');
      
      // Restrict read/download access strictly to authenticated admins/staff
      allow read: if request.auth != null;
      
      // Restrict update and delete operations strictly to authenticated staff
      allow update, delete: if request.auth != null;
    }

    match /player_photos/{imageId} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024 
                            && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    match /player-photos/{imageId} {
      allow read: if true;
      allow create, update: if request.resource.size < 10 * 1024 * 1024 
                            && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
    
    // Default fallback for any other storage path
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
